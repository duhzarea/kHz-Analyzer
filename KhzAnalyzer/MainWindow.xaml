<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="KhzAnalyzer.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="kHz Analyzer"
    mc:Ignorable="d">
    <Grid x:Name="RootGrid" Background="{ThemeResource AppFallbackBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TitleBar
            x:Name="AppTitleBar"
            Title="kHz Analyzer"
            IsBackButtonVisible="False"
            IsPaneToggleButtonVisible="False">
            <!--  The icon is set in code: ms-appx URIs need package identity, and this app is unpackaged.  -->
            <TitleBar.LeftHeader>
                <Button
                    x:Name="SidebarToggle"
                    Margin="6,0,0,0"
                    AutomationProperties.Name="Show or hide the sidebar"
                    Click="SidebarToggle_Click"
                    Style="{StaticResource QuietIconButtonStyle}"
                    ToolTipService.ToolTip="Hide sidebar (Ctrl+B)"
                    Visibility="Collapsed">
                    <FontIcon
                        x:Name="SidebarGlyph"
                        FontSize="16"
                        Glyph="&#xE89F;" />
                </Button>
            </TitleBar.LeftHeader>
        </TitleBar>

        <Grid x:Name="Body" Grid.Row="1">
            <NavigationView
                x:Name="NavView"
                IsBackButtonVisible="Collapsed"
                IsPaneToggleButtonVisible="False"
                IsSettingsVisible="True"
                OpenPaneLength="240"
                PaneDisplayMode="Left"
                SelectionChanged="NavView_SelectionChanged">
                <NavigationView.MenuItems>
                    <NavigationViewItem
                        Content="Home"
                        Tag="home"
                        ToolTipService.ToolTip="Start screen (Ctrl+0)">
                        <NavigationViewItem.Icon>
                            <FontIcon Glyph="&#xE80F;" />
                        </NavigationViewItem.Icon>
                    </NavigationViewItem>
                    <NavigationViewItem
                        x:Name="NavAnalyzer"
                        Content="Analyzer"
                        Tag="analyzer"
                        ToolTipService.ToolTip="Analyzer (Ctrl+1)">
                        <NavigationViewItem.Icon>
                            <FontIcon Glyph="&#xE721;" />
                        </NavigationViewItem.Icon>
                    </NavigationViewItem>
                    <NavigationViewItem
                        x:Name="NavDownload"
                        Content="Download &amp; Trim"
                        Tag="download"
                        ToolTipService.ToolTip="Download &amp; Trim (Ctrl+2)">
                        <NavigationViewItem.Icon>
                            <FontIcon Glyph="&#xE8C6;" />
                        </NavigationViewItem.Icon>
                    </NavigationViewItem>
                    <NavigationViewItem
                        x:Name="NavSnippets"
                        Content="Snippets"
                        Tag="snippets"
                        ToolTipService.ToolTip="Snippets (Ctrl+3)">
                        <NavigationViewItem.Icon>
                            <FontIcon Glyph="&#xE8D6;" />
                        </NavigationViewItem.Icon>
                    </NavigationViewItem>
                </NavigationView.MenuItems>
                <NavigationView.FooterMenuItems>
                    <NavigationViewItem
                        x:Name="NavAbout"
                        Content="About"
                        Tag="about"
                        ToolTipService.ToolTip="About (F1)">
                        <NavigationViewItem.Icon>
                            <FontIcon Glyph="&#xE946;" />
                        </NavigationViewItem.Icon>
                    </NavigationViewItem>
                </NavigationView.FooterMenuItems>
                <NavigationView.PaneFooter>
                    <Grid
                        x:Name="ThemeRow"
                        Margin="16,6,12,12"
                        ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="12"
                            Foreground="{ThemeResource InkFaintBrush}"
                            Text="Theme" />
                        <Button
                            x:Name="ThemeToggle"
                            Grid.Column="1"
                            Width="52"
                            Height="28"
                            Padding="0"
                            AutomationProperties.Name="Switch light and dark theme"
                            Click="ThemeToggle_Click"
                            CornerRadius="14"
                            ToolTipService.ToolTip="Switch theme (Ctrl+Shift+L)">
                            <Grid Width="50" Height="26">
                                <Border
                                    x:Name="ThemeKnob"
                                    Width="20"
                                    Height="20"
                                    Margin="3,0,3,0"
                                    HorizontalAlignment="Left"
                                    Background="{StaticResource AppleRedBrush}"
                                    CornerRadius="10">
                                    <FontIcon
                                        x:Name="ThemeGlyph"
                                        FontSize="11"
                                        Foreground="White"
                                        Glyph="&#xE706;" />
                                </Border>
                            </Grid>
                        </Button>
                    </Grid>
                </NavigationView.PaneFooter>
                <Frame x:Name="NavFrame" />
            </NavigationView>

            <!--  Start screen sits over the shell until a module is chosen  -->
            <Frame x:Name="StartFrame" />
        </Grid>

        <!--  Theme reveal paints here, above everything  -->
        <Grid
            x:Name="OverlayHost"
            Grid.RowSpan="2"
            IsHitTestVisible="False" />
    </Grid>
</Window>
