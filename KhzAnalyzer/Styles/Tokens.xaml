<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="AppFallbackBackgroundBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="SurfaceCardBrush" Color="#08000000" />
            <SolidColorBrush x:Key="SurfaceCardHoverBrush" Color="#0C000000" />
            <SolidColorBrush x:Key="BrandAccentBrush" Color="#c2410c" />
            <SolidColorBrush x:Key="BrandAccentHoverBrush" Color="#9a3412" />
            <SolidColorBrush x:Key="SuccessBrush" Color="#166534" />
            <SolidColorBrush x:Key="DangerBrush" Color="#b91c1c" />
            <SolidColorBrush x:Key="NeutralErrorBrush" Color="#475569" />
            <SolidColorBrush x:Key="TextPrimaryBrush" Color="#E4000000" />
            <SolidColorBrush x:Key="TextSecondaryBrush" Color="#99000000" />
            <SolidColorBrush x:Key="TextInverseBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="BorderSubtleBrush" Color="#10000000" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
            <SolidColorBrush x:Key="AppFallbackBackgroundBrush" Color="#050505" />
            <SolidColorBrush x:Key="SurfaceCardBrush" Color="#0DFFFFFF" />
            <SolidColorBrush x:Key="SurfaceCardHoverBrush" Color="#14FFFFFF" />
            <SolidColorBrush x:Key="BrandAccentBrush" Color="#f97316" />
            <SolidColorBrush x:Key="BrandAccentHoverBrush" Color="#fdba74" />
            <SolidColorBrush x:Key="SuccessBrush" Color="#2ea043" />
            <SolidColorBrush x:Key="DangerBrush" Color="#ef4444" />
            <SolidColorBrush x:Key="NeutralErrorBrush" Color="#94a3b8" />
            <SolidColorBrush x:Key="TextPrimaryBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="TextSecondaryBrush" Color="#99FFFFFF" />
            <SolidColorBrush x:Key="TextInverseBrush" Color="#E4000000" />
            <SolidColorBrush x:Key="BorderSubtleBrush" Color="#1AFFFFFF" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="HighContrast">
            <SolidColorBrush x:Key="AppFallbackBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="SurfaceCardBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="SurfaceCardHoverBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="BrandAccentBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="BrandAccentHoverBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="SuccessBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="DangerBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="NeutralErrorBrush" Color="{ThemeResource SystemColorGrayTextColor}" />
            <SolidColorBrush x:Key="TextPrimaryBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="TextSecondaryBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="TextInverseBrush" Color="{ThemeResource SystemColorHighlightTextColor}" />
            <SolidColorBrush x:Key="BorderSubtleBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <!-- Tipografia (FontFamilies) -->
    <FontFamily x:Key="InterMediumFontFamily">ms-appx:///Assets/Fonts/Inter-Medium.ttf#Inter Medium</FontFamily>
    <FontFamily x:Key="InterSemiBoldFontFamily">ms-appx:///Assets/Fonts/Inter-SemiBold.ttf#Inter SemiBold</FontFamily>
    <FontFamily x:Key="SystemIconsFontFamily">Segoe MDL2 Assets</FontFamily>

    <CornerRadius x:Key="ButtonCornerRadius">22</CornerRadius>
    <CornerRadius x:Key="BadgeCornerRadius">12</CornerRadius>
    <CornerRadius x:Key="CardCornerRadius">8</CornerRadius>
    <CornerRadius x:Key="InputCornerRadius">6</CornerRadius>

    <Thickness x:Key="SpacingSmall">8</Thickness>
    <Thickness x:Key="SpacingMedium">16</Thickness>
    <Thickness x:Key="SpacingLarge">24</Thickness>
    <Thickness x:Key="SpacingXLarge">32</Thickness>
    
    <Thickness x:Key="ControlPaddingStandard">24,0</Thickness>
    <Thickness x:Key="StatusBadgePadding">8,0</Thickness>
    <Thickness x:Key="ToolTipPadding">8</Thickness>
    <Thickness x:Key="InputTextMargin">16,0,16,0</Thickness>
    <Thickness x:Key="ControlBorderThickness">1</Thickness>
    <Thickness x:Key="NoBorderThickness">0</Thickness>
    
    <x:Double x:Key="ControlHeightStandard">44</x:Double>
    <x:Double x:Key="ControlHeightBadge">24</x:Double>
    <x:Double x:Key="FontSizeStandard">14</x:Double>
    <x:Double x:Key="ToolTipFontSize">12</x:Double>

    <KeyTime x:Key="DurationFastKeyTime">0:0:0.150</KeyTime>
    <KeyTime x:Key="DurationNormalKeyTime">0:0:0.300</KeyTime>
    <KeyTime x:Key="DurationSlowKeyTime">0:0:0.800</KeyTime>
    <KeySpline x:Key="SpringEasing">0.2,0.8,0.2,1</KeySpline>

</ResourceDictionary>
