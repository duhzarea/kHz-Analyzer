<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Families (design system: display / sans / mono). Local TTF files, family names as stored in the fonts. -->
    <FontFamily x:Key="DisplayFontFamily">ms-appx:///Assets/Fonts/InstrumentSerif-Regular.ttf#Instrument Serif</FontFamily>
    <FontFamily x:Key="DisplayItalicFontFamily">ms-appx:///Assets/Fonts/InstrumentSerif-Italic.ttf#Instrument Serif</FontFamily>
    <FontFamily x:Key="SansFontFamily">ms-appx:///Assets/Fonts/Inter-Variable.ttf#Inter</FontFamily>
    <FontFamily x:Key="InterMediumFontFamily">ms-appx:///Assets/Fonts/Inter-Medium.ttf#Inter Medium</FontFamily>
    <FontFamily x:Key="InterSemiBoldFontFamily">ms-appx:///Assets/Fonts/Inter-SemiBold.ttf#Inter SemiBold</FontFamily>
    <FontFamily x:Key="MonoFontFamily">ms-appx:///Assets/Fonts/GeistMono-Variable.ttf#Geist Mono</FontFamily>
    <FontFamily x:Key="SystemIconsFontFamily">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

    <!-- Roles. CharacterSpacing is in 1/1000 em: -0.02em = -20, 0.1em = 100. -->
    <Style x:Key="DisplayTextBlockStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource DisplayFontFamily}" />
        <Setter Property="FontSize" Value="72" /><Setter Property="LineHeight" Value="68" /><Setter Property="CharacterSpacing" Value="-20" />
        <Setter Property="Foreground" Value="{ThemeResource InkBrush}" /><Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="H1TextBlockStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource DisplayFontFamily}" />
        <Setter Property="FontSize" Value="56" /><Setter Property="LineHeight" Value="56" /><Setter Property="CharacterSpacing" Value="-20" />
        <Setter Property="Foreground" Value="{ThemeResource InkBrush}" /><Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="H2TextBlockStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource InterMediumFontFamily}" />
        <Setter Property="FontSize" Value="32" /><Setter Property="LineHeight" Value="38" /><Setter Property="CharacterSpacing" Value="-25" />
        <Setter Property="Foreground" Value="{ThemeResource InkBrush}" /><Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="H3TextBlockStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource InterMediumFontFamily}" />
        <Setter Property="FontSize" Value="24" /><Setter Property="LineHeight" Value="30" /><Setter Property="CharacterSpacing" Value="-25" />
        <Setter Property="Foreground" Value="{ThemeResource InkBrush}" /><Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="H4TextBlockStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource InterSemiBoldFontFamily}" />
        <Setter Property="FontSize" Value="20" /><Setter Property="LineHeight" Value="26" /><Setter Property="CharacterSpacing" Value="-15" />
        <Setter Property="Foreground" Value="{ThemeResource InkBrush}" /><Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="H5TextBlockStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource InterSemiBoldFontFamily}" />
        <Setter Property="FontSize" Value="16" /><Setter Property="LineHeight" Value="22" /><Setter Property="CharacterSpacing" Value="-10" />
        <Setter Property="Foreground" Value="{ThemeResource InkBrush}" />
    </Style>
    <Style x:Key="EyebrowTextBlockStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource MonoFontFamily}" /><Setter Property="FontWeight" Value="Medium" />
        <Setter Property="FontSize" Value="12" /><Setter Property="CharacterSpacing" Value="100" />
        <Setter Property="Foreground" Value="{ThemeResource InkFaintBrush}" />
    </Style>
    <Style x:Key="BodyLargeTextBlockStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource SansFontFamily}" />
        <Setter Property="FontSize" Value="16" /><Setter Property="LineHeight" Value="26" />
        <Setter Property="Foreground" Value="{ThemeResource InkMutedBrush}" /><Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="BodyMediumTextBlockStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource SansFontFamily}" />
        <Setter Property="FontSize" Value="14" /><Setter Property="LineHeight" Value="22" />
        <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
        <Setter Property="Foreground" Value="{ThemeResource InkBrush}" /><Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="BodySmallTextBlockStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource SansFontFamily}" />
        <Setter Property="FontSize" Value="12" /><Setter Property="LineHeight" Value="18" />
        <Setter Property="Foreground" Value="{ThemeResource InkMutedBrush}" /><Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="CaptionKhzTextBlockStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource InterMediumFontFamily}" />
        <Setter Property="FontSize" Value="12" /><Setter Property="CharacterSpacing" Value="10" />
        <Setter Property="Foreground" Value="{ThemeResource InkFaintBrush}" />
    </Style>
    <Style x:Key="LabelTextBlockStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource InterSemiBoldFontFamily}" />
        <Setter Property="FontSize" Value="12" /><Setter Property="CharacterSpacing" Value="40" />
        <Setter Property="Foreground" Value="{ThemeResource InkFaintBrush}" />
    </Style>
    <Style x:Key="HelperTextBlockStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource SansFontFamily}" />
        <Setter Property="FontSize" Value="12" /><Setter Property="Foreground" Value="{ThemeResource InkFaintBrush}" /><Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="DataTextBlockStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource MonoFontFamily}" /><Setter Property="FontWeight" Value="Medium" />
        <Setter Property="FontSize" Value="13" /><Setter Property="Typography.NumeralAlignment" Value="Tabular" />
        <Setter Property="Foreground" Value="{ThemeResource InkMutedBrush}" />
    </Style>
    <Style x:Key="StatValueTextBlockStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource InterMediumFontFamily}" />
        <Setter Property="FontSize" Value="30" /><Setter Property="CharacterSpacing" Value="-25" />
        <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
        <Setter Property="Foreground" Value="{ThemeResource InkBrush}" />
    </Style>
</ResourceDictionary>
