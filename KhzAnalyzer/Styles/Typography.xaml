<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Famílias de Fontes (As famílias Inter são referenciadas de Tokens.xaml) -->
    
    <!-- Cascata de Ícones do Sistema -->
    <FontFamily x:Key="SystemIconsFontFamily">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

    <!-- Escala Tipográfica (Tamanhos e Espaçamentos extraídos da fase de design) -->
    
    <Style x:Key="H1TextBlockStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource InterMediumFontFamily}"/>
        <Setter Property="FontSize" Value="48"/>
        <Setter Property="CharacterSpacing" Value="-50"/>
        <Setter Property="Foreground" Value="{ThemeResource TextPrimaryBrush}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <Style x:Key="H2TextBlockStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource InterMediumFontFamily}"/>
        <Setter Property="FontSize" Value="32"/>
        <Setter Property="CharacterSpacing" Value="-25"/>
        <Setter Property="Foreground" Value="{ThemeResource TextPrimaryBrush}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <Style x:Key="H3TextBlockStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource InterMediumFontFamily}"/>
        <Setter Property="FontSize" Value="24"/>
        <Setter Property="CharacterSpacing" Value="-25"/>
        <Setter Property="Foreground" Value="{ThemeResource TextPrimaryBrush}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <Style x:Key="BodyLargeTextBlockStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource InterMediumFontFamily}"/>
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="CharacterSpacing" Value="0"/>
        <Setter Property="Foreground" Value="{ThemeResource TextSecondaryBrush}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <!-- BodyMedium com alinhamento Tabular exigido para a tabela -->
    <Style x:Key="BodyMediumTextBlockStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource InterMediumFontFamily}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="CharacterSpacing" Value="0"/>
        <Setter Property="Typography.NumeralAlignment" Value="Tabular"/>
        <Setter Property="Foreground" Value="{ThemeResource TextPrimaryBrush}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <Style x:Key="BodySmallTextBlockStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource InterMediumFontFamily}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="CharacterSpacing" Value="0"/>
        <Setter Property="Foreground" Value="{ThemeResource TextSecondaryBrush}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <Style x:Key="LabelTextBlockStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource InterSemiBoldFontFamily}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="CharacterSpacing" Value="0"/>
        <Setter Property="Foreground" Value="{ThemeResource TextPrimaryBrush}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <!-- Nota: WinUI 3 não possui TextTransform="Uppercase" em XAML. A conversão de caixa deverá ocorrer no Binding/Code -->
    </Style>

</ResourceDictionary>
