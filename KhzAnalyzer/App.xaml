<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="KhzAnalyzer.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:KhzAnalyzer">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <ResourceDictionary Source="ms-appx:///Styles/Tokens.xaml" />
                <ResourceDictionary Source="ms-appx:///Styles/Typography.xaml" />
                <ResourceDictionary Source="ms-appx:///Styles/Animations.xaml" />
                <ResourceDictionary Source="ms-appx:///Styles/Controls.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
