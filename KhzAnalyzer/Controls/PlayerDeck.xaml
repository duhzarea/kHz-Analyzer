<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="KhzAnalyzer.Controls.PlayerDeck"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:KhzAnalyzer.Controls">

    <Grid>
        <!--  Halo behind the deck, stronger while playing  -->
        <Border
            x:Name="Halo"
            Margin="-26,-20,-26,-30"
            Background="{StaticResource EmberGlowBrush}"
            CornerRadius="60"
            IsHitTestVisible="False"
            Opacity="0.28" />

        <!--  Aura rim: a 1.5px gradient hairline that slowly turns  -->
        <Border Padding="1.5" CornerRadius="24">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <LinearGradientBrush.RelativeTransform>
                        <RotateTransform x:Name="RimSpin" CenterX="0.5" CenterY="0.5" />
                    </LinearGradientBrush.RelativeTransform>
                    <GradientStop Offset="0" Color="#FFFA243C" />
                    <GradientStop Offset="0.35" Color="#FFFF8A9B" />
                    <GradientStop Offset="0.65" Color="#FF22D3EE" />
                    <GradientStop Offset="1" Color="#FFFA243C" />
                </LinearGradientBrush>
            </Border.Background>
            <Border.Triggers>
                <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                    <BeginStoryboard>
                        <Storyboard RepeatBehavior="Forever">
                            <DoubleAnimation
                                Storyboard.TargetName="RimSpin"
                                Storyboard.TargetProperty="Angle"
                                From="0"
                                To="360"
                                Duration="0:0:9" />
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </Border.Triggers>

            <Border
                Padding="20,18,20,16"
                Background="{ThemeResource DeckBrush}"
                CornerRadius="22.5">
                <Grid RowSpacing="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            x:Name="TitleText"
                            FontFamily="{StaticResource InterSemiBoldFontFamily}"
                            FontSize="17"
                            Foreground="{ThemeResource InkBrush}"
                            Text="Nothing playing"
                            TextTrimming="CharacterEllipsis" />
                        <ToggleButton
                            x:Name="RepeatButton"
                            Grid.Column="1"
                            Width="32"
                            Height="28"
                            Padding="0"
                            Background="Transparent"
                            BorderThickness="0"
                            Click="RepeatButton_Click"
                            CornerRadius="8"
                            Foreground="{ThemeResource InkMutedBrush}"
                            ToolTipService.ToolTip="Repeat this track">
                            <FontIcon FontSize="14" Glyph="&#xE8EE;" />
                        </ToggleButton>
                    </Grid>

                    <TextBlock
                        x:Name="MetaText"
                        Grid.Row="1"
                        Margin="0,3,0,0"
                        FontFamily="{StaticResource MonoFontFamily}"
                        FontSize="11"
                        Foreground="{ThemeResource InkFaintBrush}"
                        Text="Double-click a track, or press Space"
                        TextTrimming="CharacterEllipsis" />

                    <Canvas
                        x:Name="Wave"
                        Grid.Row="2"
                        Height="72"
                        Margin="0,14,0,4" />

                    <local:Scrubber
                        x:Name="Scrub"
                        Grid.Row="3"
                        AutomationProperties.Name="Playback position" />

                    <Grid Grid.Row="4" Margin="0,2,0,0">
                        <TextBlock
                            x:Name="ElapsedText"
                            FontFamily="{StaticResource MonoFontFamily}"
                            FontSize="11"
                            Foreground="{ThemeResource InkMutedBrush}"
                            Text="00:00" />
                        <TextBlock
                            x:Name="RemainingText"
                            HorizontalAlignment="Right"
                            FontFamily="{StaticResource MonoFontFamily}"
                            FontSize="11"
                            Foreground="{ThemeResource InkMutedBrush}"
                            Text="-00:00" />
                    </Grid>

                    <!--  Transport: sized to sit inside the deck  -->
                    <StackPanel
                        Grid.Row="5"
                        Margin="0,8,0,6"
                        HorizontalAlignment="Center"
                        Orientation="Horizontal"
                        Spacing="20">
                        <Button
                            x:Name="PrevButton"
                            Width="36"
                            Height="36"
                            VerticalAlignment="Center"
                            AutomationProperties.Name="Previous track"
                            Click="PrevButton_Click"
                            Style="{StaticResource DomeButtonStyle}"
                            ToolTipService.ToolTip="Previous (Ctrl+←)">
                            <FontIcon FontSize="12" Glyph="&#xE892;" />
                        </Button>
                        <Button
                            x:Name="PlayButton"
                            Width="50"
                            Height="50"
                            VerticalAlignment="Center"
                            AutomationProperties.Name="Play"
                            Click="PlayButton_Click"
                            Style="{StaticResource PlayDomeButtonStyle}"
                            ToolTipService.ToolTip="Play / Pause (Space)">
                            <FontIcon
                                x:Name="PlayGlyph"
                                Margin="2,0,0,0"
                                FontSize="17"
                                Glyph="&#xE768;" />
                        </Button>
                        <Button
                            x:Name="NextButton"
                            Width="36"
                            Height="36"
                            VerticalAlignment="Center"
                            AutomationProperties.Name="Next track"
                            Click="NextButton_Click"
                            Style="{StaticResource DomeButtonStyle}"
                            ToolTipService.ToolTip="Next (Ctrl+→)">
                            <FontIcon FontSize="12" Glyph="&#xE893;" />
                        </Button>
                    </StackPanel>

                    <Grid Grid.Row="6" ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <FontIcon
                            x:Name="VolumeGlyph"
                            FontSize="13"
                            Foreground="{ThemeResource InkFaintBrush}"
                            Glyph="&#xE995;" />
                        <Slider
                            x:Name="VolumeSlider"
                            Grid.Column="1"
                            Maximum="100"
                            Minimum="0"
                            RequestedTheme="Dark"
                            AutomationProperties.Name="Volume"
                            ValueChanged="VolumeSlider_ValueChanged"
                            Value="80" />
                    </Grid>
                </Grid>
            </Border>
        </Border>
    </Grid>
</UserControl>
