<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="KhzAnalyzer.Pages.DownloadPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    NavigationCacheMode="Required">

    <Grid>
        <ScrollViewer>
            <StackPanel
                MaxWidth="860"
                Padding="28,20,28,28"
                HorizontalAlignment="Left"
                Spacing="18">

                <StackPanel Spacing="2">
                    <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="Download &amp; Trim" />
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource BodyTextBlockStyle}"
                        Text="Save audio or video from a YouTube or SoundCloud link, whole or cut by time codes." />
                </StackPanel>

                <InfoBar
                    x:Name="ToolsMissingBar"
                    IsClosable="False"
                    IsOpen="False"
                    Severity="Error"
                    Title="Required tools not found" />

                <!--  Link  -->
                <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox
                        x:Name="UrlBox"
                        KeyDown="UrlBox_KeyDown"
                        PlaceholderText="Paste a YouTube or SoundCloud link" />
                    <Button
                        x:Name="FetchButton"
                        Grid.Column="1"
                        Click="FetchButton_Click">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon FontSize="15" Glyph="&#xE721;" />
                            <TextBlock Text="Get info" />
                        </StackPanel>
                    </Button>
                </Grid>

                <!--  Preview  -->
                <Border
                    x:Name="PreviewCard"
                    Padding="14"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Visibility="Collapsed">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border
                            Width="192"
                            Height="108"
                            Background="{ThemeResource SurfaceCardBrush}"
                            CornerRadius="6">
                            <Image x:Name="ThumbImage" Stretch="UniformToFill" />
                        </Border>
                        <StackPanel
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Spacing="4">
                            <TextBlock
                                x:Name="InfoTitle"
                                MaxLines="2"
                                Style="{StaticResource BodyStrongTextBlockStyle}"
                                TextTrimming="CharacterEllipsis"
                                TextWrapping="Wrap" />
                            <TextBlock x:Name="InfoMeta" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!--  Options  -->
                <StackPanel x:Name="OptionsPanel" Spacing="18">
                    <StackPanel Spacing="6">
                        <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Format" />
                        <RadioButtons
                            x:Name="FormatChoice"
                            MaxColumns="4"
                            SelectedIndex="0">
                            <RadioButton Content="WAV" Tag="Wav" />
                            <RadioButton Content="M4A" Tag="M4a" />
                            <RadioButton Content="MP3" Tag="Mp3" />
                            <RadioButton Content="MP4 video" Tag="Mp4" />
                        </RadioButtons>
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="Streaming sources are lossy. Saving as WAV does not restore quality, and such files may fail the 19 kHz check."
                            TextWrapping="Wrap" />
                    </StackPanel>

                    <StackPanel Spacing="6">
                        <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Trim" />
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <TextBox
                                x:Name="StartBox"
                                Width="150"
                                Header="Start"
                                PlaceholderText="00:00:00" />
                            <TextBox
                                x:Name="EndBox"
                                Width="150"
                                Header="End"
                                PlaceholderText="00:00:00" />
                        </StackPanel>
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="Leave both empty to keep everything. Use HH:MM:SS, MM:SS or seconds." />
                    </StackPanel>

                    <TextBox
                        x:Name="FileNameBox"
                        Header="File name"
                        PlaceholderText="The extension is added automatically" />

                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="FolderBox" Header="Save to" />
                        <Button
                            Grid.Column="1"
                            VerticalAlignment="Bottom"
                            Click="BrowseButton_Click">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon FontSize="15" Glyph="&#xE838;" />
                                <TextBlock Text="Browse" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Spacing="10">
                    <Button
                        x:Name="DownloadButton"
                        Click="DownloadButton_Click"
                        Style="{StaticResource AccentButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon FontSize="15" Glyph="&#xE896;" />
                            <TextBlock Text="Download" />
                        </StackPanel>
                    </Button>
                    <Button
                        x:Name="CancelButton"
                        Click="CancelButton_Click"
                        IsEnabled="False">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon FontSize="15" Glyph="&#xE711;" />
                            <TextBlock Text="Cancel" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <StackPanel Spacing="6">
                    <ProgressBar
                        x:Name="Progress"
                        Foreground="{ThemeResource SuccessBrush}"
                        Maximum="100"
                        Minimum="0"
                        Value="0" />
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            x:Name="LogText"
                            FontStyle="Italic"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="Ready."
                            TextTrimming="CharacterEllipsis" />
                        <TextBlock
                            x:Name="PercentText"
                            Grid.Column="1"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}" />
                    </Grid>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!--  Completion: check mark over a blurred page  -->
        <Grid
            x:Name="DoneOverlay"
            Background="{ThemeResource AcrylicInAppFillColorDefaultBrush}"
            Visibility="Collapsed">
            <StackPanel
                MaxWidth="520"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="14">
                <FontIcon
                    FontSize="64"
                    Foreground="{ThemeResource SuccessBrush}"
                    Glyph="&#xE930;" />
                <TextBlock
                    HorizontalAlignment="Center"
                    Style="{StaticResource SubtitleTextBlockStyle}"
                    Text="Saved" />
                <TextBlock
                    x:Name="DoneFileText"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    HorizontalTextAlignment="Center"
                    TextWrapping="Wrap" />
                <StackPanel
                    HorizontalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="10">
                    <Button Click="ShowInFolder_Click" Content="Show in folder" />
                    <Button
                        Click="DoneClose_Click"
                        Content="Done"
                        Style="{StaticResource AccentButtonStyle}" />
                </StackPanel>
            </StackPanel>
        </Grid>
    </Grid>
</Page>
