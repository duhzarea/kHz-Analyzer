<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="KhzAnalyzer.Pages.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:KhzAnalyzer.Models"
    NavigationCacheMode="Required"
    mc:Ignorable="d">

    <Grid Padding="28,20,28,20" RowSpacing="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  Cabeçalho: título + seleção de pasta  -->
        <StackPanel Grid.Row="0" Spacing="14">
            <StackPanel Spacing="2">
                <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="Analyzer" />
                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource BodyTextBlockStyle}"
                    Text="Checks whether each track has real spectral content up to 20 kHz. Anything lower is flagged for checking." />
            </StackPanel>

            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBox
                    x:Name="PastaTextBox"
                    Grid.Column="0"
                    PlaceholderText="Paste a folder path here, or use Browse…" />

                <Button
                    x:Name="ProcurarButton"
                    Grid.Column="1"
                    Click="ProcurarButton_Click">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontSize="15" Glyph="&#xE838;" />
                        <TextBlock Text="Browse" />
                    </StackPanel>
                </Button>

                <Button
                    x:Name="AnalisarButton"
                    Grid.Column="2"
                    Click="AnalisarButton_Click"
                    Style="{StaticResource AccentButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontSize="15" Glyph="&#xE768;" />
                        <TextBlock Text="Analyze" />
                    </StackPanel>
                </Button>

                <Button
                    x:Name="CancelarButton"
                    Grid.Column="3"
                    Click="CancelarButton_Click"
                    IsEnabled="False">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontSize="15" Glyph="&#xE711;" />
                        <TextBlock Text="Cancel" />
                    </StackPanel>
                </Button>

                <Button
                    x:Name="ExportarButton"
                    Grid.Column="4"
                    Click="ExportarButton_Click"
                    IsEnabled="False">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontSize="15" Glyph="&#xE74E;" />
                        <TextBlock Text="Export" />
                    </StackPanel>
                </Button>
            </Grid>
        </StackPanel>

        <!--  Cartões de estatística  -->
        <Grid Grid.Row="1" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border
                Grid.Column="0"
                Padding="18,14"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <StackPanel Spacing="2">
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="TOTAL" />
                    <TextBlock
                        x:Name="TotalText"
                        Style="{StaticResource SubtitleTextBlockStyle}"
                        Text="0" />
                </StackPanel>
            </Border>

            <Border
                Grid.Column="1"
                Padding="18,14"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <StackPanel Spacing="2">
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="PASSED" />
                    <TextBlock
                        x:Name="OkText"
                        Foreground="#2EA043"
                        Style="{StaticResource SubtitleTextBlockStyle}"
                        Text="0" />
                </StackPanel>
            </Border>

            <Border
                Grid.Column="2"
                Padding="18,14"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <StackPanel Spacing="2">
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="BELOW 20 kHz" />
                    <TextBlock
                        x:Name="AbaixoText"
                        Foreground="#E04A3F"
                        Style="{StaticResource SubtitleTextBlockStyle}"
                        Text="0" />
                </StackPanel>
            </Border>

            <Border
                Grid.Column="3"
                Padding="18,14"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <StackPanel Spacing="2">
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="ERRORS" />
                    <TextBlock
                        x:Name="ErroText"
                        Foreground="#F59E0B"
                        Style="{StaticResource SubtitleTextBlockStyle}"
                        Text="0" />
                </StackPanel>
            </Border>

            <Border
                Grid.Column="4"
                Padding="18,14"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <StackPanel Spacing="2">
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="NOT DOWNLOADED" />
                    <TextBlock
                        x:Name="OfflineText"
                        Foreground="#8B8B8B"
                        Style="{StaticResource SubtitleTextBlockStyle}"
                        Text="0" />
                </StackPanel>
            </Border>
        </Grid>

        <!--  Progresso  -->
        <StackPanel Grid.Row="2" Spacing="6">
            <ProgressBar
                x:Name="Progresso"
                Maximum="1"
                Minimum="0"
                Value="0" />
            <TextBlock
                x:Name="StatusText"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{StaticResource CaptionTextBlockStyle}"
                Text="Ready." />
        </StackPanel>

        <!--  Filtros + busca  -->
        <Grid Grid.Row="3" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel
                Grid.Column="0"
                Orientation="Horizontal"
                Spacing="8">
                <RadioButton
                    x:Name="FiltroTodos"
                    Checked="Filtro_Changed"
                    Content="All"
                    GroupName="Filtro"
                    IsChecked="True"
                    Style="{StaticResource DefaultRadioButtonStyle}" />
                <RadioButton
                    x:Name="FiltroOk"
                    Checked="Filtro_Changed"
                    Content="Passed"
                    GroupName="Filtro" />
                <RadioButton
                    x:Name="FiltroProblemas"
                    Checked="Filtro_Changed"
                    Content="Issues"
                    GroupName="Filtro" />
            </StackPanel>

            <AutoSuggestBox
                x:Name="BuscaBox"
                Grid.Column="1"
                HorizontalAlignment="Stretch"
                PlaceholderText="Search tracks…"
                QueryIcon="Find"
                TextChanged="BuscaBox_TextChanged" />
        </Grid>

        <!--  Tabela de resultados  -->
        <Border
            Grid.Row="4"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!--  Cabeçalho da tabela  -->
                <Grid
                    Grid.Row="0"
                    Padding="16,12"
                    BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                    BorderThickness="0,0,0,1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="32" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="60" />
                        <ColumnDefinition Width="60" />
                        <ColumnDefinition Width="70" />
                        <ColumnDefinition Width="100" />
                        <ColumnDefinition Width="70" />
                        <ColumnDefinition Width="100" />
                        <ColumnDefinition Width="170" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        Grid.Column="1"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="TRACK" />
                    <TextBlock
                        Grid.Column="2"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="KEY" />
                    <TextBlock
                        Grid.Column="3"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="BPM" />
                    <TextBlock
                        Grid.Column="4"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="FORMAT" />
                    <TextBlock
                        Grid.Column="5"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="SAMPLE RATE" />
                    <TextBlock
                        Grid.Column="6"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="BITS" />
                    <TextBlock
                        Grid.Column="7"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="MAX FREQ." />
                    <TextBlock
                        Grid.Column="8"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="VERDICT" />
                </Grid>

                <ListView
                    x:Name="ResultadosList"
                    Grid.Row="1"
                    IsItemClickEnabled="False"
                    SelectionMode="Single">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="16,8" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:TrackRow">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="32" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="60" />
                                    <ColumnDefinition Width="60" />
                                    <ColumnDefinition Width="70" />
                                    <ColumnDefinition Width="100" />
                                    <ColumnDefinition Width="70" />
                                    <ColumnDefinition Width="100" />
                                    <ColumnDefinition Width="170" />
                                </Grid.ColumnDefinitions>

                                <FontIcon
                                    Grid.Column="0"
                                    HorizontalAlignment="Left"
                                    FontSize="14"
                                    Foreground="{x:Bind StatusBrush}"
                                    Glyph="{x:Bind StatusGlyph}" />
                                <TextBlock
                                    Grid.Column="1"
                                    Margin="0,0,12,0"
                                    Text="{x:Bind Faixa}"
                                    TextTrimming="CharacterEllipsis"
                                    ToolTipService.ToolTip="{x:Bind CaminhoCompleto}" />
                                <TextBlock
                                    Grid.Column="2"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="{x:Bind Key}" />
                                <TextBlock
                                    Grid.Column="3"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="{x:Bind Bpm}" />
                                <TextBlock
                                    Grid.Column="4"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="{x:Bind Formato}" />
                                <TextBlock
                                    Grid.Column="5"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="{x:Bind SampleRate}" />
                                <TextBlock
                                    Grid.Column="6"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="{x:Bind Bits}" />
                                <TextBlock
                                    Grid.Column="7"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="{x:Bind FreqMax}" />
                                <TextBlock
                                    Grid.Column="8"
                                    Foreground="{x:Bind StatusBrush}"
                                    Text="{x:Bind Veredito}"
                                    TextTrimming="CharacterEllipsis" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Border>
    </Grid>
</Page>
