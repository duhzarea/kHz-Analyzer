<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="KhzAnalyzer.Pages.ComingSoonPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Padding="28,20,28,20" RowSpacing="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TextBlock x:Name="TitleText" Style="{StaticResource TitleTextBlockStyle}" />
        <StackPanel
            Grid.Row="1"
            MaxWidth="520"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="12">
            <FontIcon
                x:Name="Icon"
                FontSize="40"
                Foreground="{ThemeResource BrandAccentBrush}" />
            <TextBlock
                HorizontalAlignment="Center"
                Style="{StaticResource SubtitleTextBlockStyle}"
                Text="Not in this build yet" />
            <TextBlock
                x:Name="BodyText"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                HorizontalTextAlignment="Center"
                TextWrapping="Wrap" />
        </StackPanel>
    </Grid>
</Page>
