<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="KhzAnalyzer.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer x:Name="Scroller" Padding="36,20,36,28">
        <StackPanel MaxWidth="760" HorizontalAlignment="Left" Spacing="28">
            <StackPanel Spacing="4">
                <TextBlock Style="{StaticResource EyebrowTextBlockStyle}" Text="SETTINGS" />
                <TextBlock Style="{StaticResource H1TextBlockStyle}" Text="Make it yours" />
            </StackPanel>

            <!--  Appearance  -->
            <Border Padding="22,18" Style="{StaticResource GlassCardStyle}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="4">
                        <TextBlock Style="{StaticResource H5TextBlockStyle}" Text="Appearance" />
                        <TextBlock
                            Foreground="{ThemeResource InkMutedBrush}"
                            Text="Light or dark. The new theme spreads out from where you click."
                            TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Orientation="Horizontal"
                        Spacing="8">
                        <RadioButton
                            x:Name="LightChoice"
                            Click="Theme_Click"
                            Content="Light"
                            GroupName="Theme"
                            Style="{StaticResource SegmentRadioButtonStyle}"
                            Tag="Light" />
                        <RadioButton
                            x:Name="DarkChoice"
                            Click="Theme_Click"
                            Content="Dark"
                            GroupName="Theme"
                            Style="{StaticResource SegmentRadioButtonStyle}"
                            Tag="Dark" />
                    </StackPanel>
                </Grid>
            </Border>

            <!--  Motion  -->
            <Border Padding="22,18" Style="{StaticResource GlassCardStyle}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="4">
                        <TextBlock Style="{StaticResource H5TextBlockStyle}" Text="Animations" />
                        <TextBlock
                            Foreground="{ThemeResource InkMutedBrush}"
                            Text="Entrances, the theme reveal, hover lift and counters. Follow Windows uses the Animation effects setting."
                            TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Orientation="Horizontal"
                        Spacing="8">
                        <RadioButton x:Name="MotionOn" Click="Motion_Click" Content="On" GroupName="Motion" Style="{StaticResource SegmentRadioButtonStyle}" Tag="On" />
                        <RadioButton x:Name="MotionSystem" Click="Motion_Click" Content="Follow Windows" GroupName="Motion" Style="{StaticResource SegmentRadioButtonStyle}" Tag="System" />
                        <RadioButton x:Name="MotionOff" Click="Motion_Click" Content="Off" GroupName="Motion" Style="{StaticResource SegmentRadioButtonStyle}" Tag="Off" />
                    </StackPanel>
                </Grid>
            </Border>

            <!--  Keyboard shortcuts  -->
            <Border
                x:Name="ShortcutsCard"
                Padding="22,18"
                Style="{StaticResource GlassCardStyle}">
                <StackPanel Spacing="14">
                    <StackPanel Spacing="4">
                        <TextBlock Style="{StaticResource H5TextBlockStyle}" Text="Keyboard Shortcuts" />
                        <TextBlock
                            Foreground="{ThemeResource InkMutedBrush}"
                            Text="They work anywhere in the app. While you type in a field, plain keys like Space stay with the field."
                            TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel x:Name="ShortcutList" Spacing="18" />
                </StackPanel>
            </Border>

            <!--  Troubleshooting  -->
            <Border Padding="22,18" Style="{StaticResource GlassCardStyle}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="4">
                        <TextBlock Style="{StaticResource H5TextBlockStyle}" Text="Troubleshooting" />
                        <TextBlock
                            Foreground="{ThemeResource InkMutedBrush}"
                            Text="Logs stay on this computer. Nothing is ever sent anywhere."
                            TextWrapping="Wrap" />
                    </StackPanel>
                    <Button
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Click="OpenLogs_Click"
                        Content="Open logs folder"
                        Style="{StaticResource GlassButtonStyle}" />
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
