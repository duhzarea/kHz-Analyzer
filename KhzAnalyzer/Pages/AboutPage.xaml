<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="KhzAnalyzer.Pages.AboutPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer>
        <StackPanel MaxWidth="720" Padding="28,20,28,28" HorizontalAlignment="Left" Spacing="20">
            <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="About" />

            <StackPanel Spacing="4">
                <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="kHz Analyzer" />
                <TextBlock x:Name="VersionText" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Created by DUHZZ. Free to use." />
            </StackPanel>

            <StackPanel Spacing="8">
                <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="What the Analyzer checks" />
                <TextBlock TextWrapping="Wrap" Text="Each WAV or AIFF file is read from start to finish. A track passes when it has sustained spectral content up to 20 kHz or more. Anything lower is marked with a warning sign for you to check: it was most likely made from a lossy source, such as an MP3 saved again as WAV. Original MP3 files whose content stops between 19 and 20 kHz, where the encoder cuts on purpose, are marked as tolerated. Reports always show the measured frequency in Hz, so you decide." />
            </StackPanel>

            <StackPanel Spacing="8">
                <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="How to use it" />
                <TextBlock TextWrapping="Wrap" Text="1. Open Analyzer and choose a folder. Subfolders are included." />
                <TextBlock TextWrapping="Wrap" Text="2. Select Analyze. Results appear as each track finishes, and a folder that was analyzed before opens almost instantly." />
                <TextBlock TextWrapping="Wrap" Text="3. Use Issues to see only the tracks that did not pass." />
                <TextBlock TextWrapping="Wrap" Text="4. Select Export to save a .docx and a .csv report." />
            </StackPanel>

            <StackPanel Spacing="8">
                <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Download &amp; Trim" />
                <TextBlock TextWrapping="Wrap" Text="Paste a YouTube or SoundCloud link and select Get info to see the title and length. Choose WAV, M4A, MP3 or MP4 video, optionally type start and end times, then select Download. Only download material you have the right to use." />
            </StackPanel>

            <StackPanel Spacing="8">
                <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Snippets" />
                <TextBlock TextWrapping="Wrap" Text="Add the folders where your tracks are. For every track without a preview, a cut (by default 2 minutes starting at 1:30) is saved as MP3 in a Snippets subfolder next to it. Tracks that already have a file in Snippets, Snippet, Preview or Previews are skipped, and folders with BACKUP in the name are ignored. Use Preview only to see what would be created." />
            </StackPanel>

            <StackPanel Spacing="8">
                <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Privacy" />
                <TextBlock TextWrapping="Wrap" Text="Analysis runs entirely on this computer. No audio, file name or path is sent anywhere. Download &amp; Trim connects only to the site of the link you paste." />
            </StackPanel>

            <StackPanel Spacing="8">
                <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Third-party software" />
                <TextBlock TextWrapping="Wrap" Text="Inter typeface (SIL Open Font License 1.1). SQLite (public domain). Windows App SDK and .NET (MIT License)." />
                <TextBlock TextWrapping="Wrap" Text="Download &amp; Trim uses two separate programs kept in the app's tools folder: FFmpeg (GPL version 3 build by gyan.dev, source at ffmpeg.org) and yt-dlp (The Unlicense, github.com/yt-dlp/yt-dlp). Their licence texts are in that folder." />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
